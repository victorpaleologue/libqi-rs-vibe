+    IoService<N>* _io;
+    Proc _proc;
+  // Regular:
+    KA_GENERATE_FRIEND_REGULAR_OPS_2(Dispatched, _io, _proc)
+  // Procedure<void (Args...)>:
+    template<typename... Args>
+    void operator()(Args&&... args) const
+    {
+      // The procedure and its arguments are copied, as the call may be
+      // deferred if the calling thread is not running the io service.
+      auto proc = _proc;
+      auto argsTuple = std::make_tuple(std::forward<Args>(args)...);
+      boost::asio::dispatch(*_io, [proc, argsTuple]() mutable {
+        ka::apply(proc, argsTuple);
+      });
